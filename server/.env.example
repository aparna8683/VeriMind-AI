# VeriMind AI - Environment Variables

# Server
PORT=5000
NODE_ENV=development

# Comma-separated frontend origins allowed by the API (Render)
CLIENT_URL=https://veri-mind-ai-1buf.vercel.app

# Groq LLM Inference (Primary)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Tavily Web Search (Primary)
TAVILY_API_KEY=

# Google Gemini (Optional Fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Ollama Local Development (Optional Fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Free-Tier Research Budget & Resource Limits
MAX_SEARCHES_PER_RESEARCH=3
MAX_SOURCES_PER_SEARCH=5
MAX_CLAIMS_PER_RESEARCH=10
MAX_EVIDENCE_SOURCES_PER_CLAIM=3
MAX_REVERIFICATION_ATTEMPTS=1
RESEARCH_CACHE_TTL_MINUTES=30
SEARCH_TIMEOUT_MS=15000
LLM_TIMEOUT_MS=30000
